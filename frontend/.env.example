# Public local settings only. Never put tokens or Google credentials here.
# Used only by the Vite dev server, on localhost, outside Telegram.
VITE_DEV_AUTH_ENABLED=false
# UI preview with in-memory demo data; localhost development only.
VITE_LOCAL_PREVIEW=false
VITE_DEV_TELEGRAM_USER_ID=
# Exact hostname from a temporary HTTPS tunnel, without https:// or path.
VITE_TUNNEL_HOST=
