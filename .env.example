BOT_TOKEN=replace-with-telegram-bot-token
GOOGLE_SHEET_ID=replace-with-google-sheet-id
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Required in production; must be the public HTTPS origin of the Mini App.
MINI_APP_URL=https://mini-app.example.com
# Telegram initData lifetime in seconds.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Local browser development only. The app rejects this setting in production.
DEV_AUTH_ENABLED=false
# Secret file supplied by the host (read-only); never place it in frontend.
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
# Persistent private volume for delivery claims and daily sheet backups.
STATE_DIR=data
FRONTEND_DIR=frontend/dist
BACKUP_ENABLED=true
